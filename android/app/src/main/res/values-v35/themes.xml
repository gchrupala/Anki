<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Keep the classic layout on Android 15, so the page does not run
         under the status and navigation bars. -->
    <style name="AppTheme" parent="BaseTheme">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:colorAccent">@color/pen</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
